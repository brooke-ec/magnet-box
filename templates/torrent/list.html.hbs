{{#*inline "content"}}
  <div class="column gap">
    <a href="/feed.xml" class="feed-link">
      <span class="fas"></span> RSS Feed
    </a>
    {{#if torrents}}
        <div class="scroll-container">
          <div class="torrent-list">
            <div class="torrent-list-header">
              <div>Name</div>
              <div>Size</div>
              <div>Peers</div>
              <div>Download</div>
              <div>Date</div>
            </div>
            {{#each torrents}}
              <div class="torrent-list-row">
                <div><span class="fas"></span> <a href="{{url}}">{{name}}</a></div>
                <div>{{size}}</div>
                <div>
                  <span class="fas"></span> {{seeders}} <span class="fas"></span> {{leechers}}
                </div>
                <div>
                  <a href="{{magnet}}" class="fas"></a>
                  <a href="{{download}}" class="fas"></a>
                </div>
                <div>{{date}}</div>
              </div>
            {{/each}}
          </div>
        </div>
    {{else}}
      <main>
        No torrents uploaded yet!
        {{#if user}}
          <a href="/torrent/upload" class="underlined">Upload a torrent</a>
        {{else}}
          <a href="/auth/login" class="underlined">Login</a>
        {{/if}}
        to get started!
      </main>
    {{/if}}
  </div>
{{/inline}}

{{> layout }}