{{#*inline "content"}}
  <main class="column gap">
    <h1 class="torrent-title">{{name}}</h1>
    <span class="torrent-meta">
      {{#if user.is_admin}}
        {{author}} • 
      {{/if}}
      {{date}} • 
      {{size}} • 
      {{leechers}} leechers • 
      {{seeders}} seeders
    </span>
    <div class="row gap">
      <a class="box" href="{{magnet}}" class="button">
        <span>Magnet Link</span>
        <span class="fas icon-margin-left"></span>
      </a>
      <a class="box" href="{{download}}" class="button">
        <span>Download</span>
        <span class="fas icon-margin-left"></span>
      </a>
      {{#if user.is_admin}}
        <a class="box" href="/torrent/{{id}}/delete" class="button">
          <span>Delete</span>
          <span class="fas icon-margin-left"></span>
        </a>
      {{/if}}
    </div>
    <h2 class="torrent-files-heading">Files</h2>
    <div class="box">
      <div class="file-tree">
        {{#each tree}}
          <div class="file-tree-item">
            <span class="file-tree-indent">{{indent}}</span>
            {{#if is_file}}
              <span class="fas file-tree-icon"></span>
            {{else}}
              <span class="fas file-tree-icon folder"></span>
            {{/if}}
            <span class="file-tree-name">{{name}}</span>
            <span class="file-tree-size">{{size}}</span>
          </div>
        {{/each}}
      </div>
    </div>
  </main>
{{/inline}}

{{> layout }}