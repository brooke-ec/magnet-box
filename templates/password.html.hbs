{{#*inline "content"}}
  <main>
    <h1>Update Password</h1>
    <p>Hi {{username}}, you can use this form to update your password!</p>
    <form method="POST">
      <div class="column">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required>
      </div>
      <div class="column">
        <label for="confirm">Confirm</label>
        <input type="password" id="confirm" name="confirm" required>
      </div>
      <button style="display: flex; align-items: center; gap: 10px" type="submit"><span class="fas"></span> Update Password</button>
    </form>
  </main>
{{/inline}}

{{> layout }}