{{#*inline "content"}}
  <main>
    <div>
      <h1>Welcome {{user.username}}</h1>
      <p>As a member of this website, you can upload your own torrents to the tracker.</p>
    </div>
    {{#if user.is_admin}}
      <a class="box" href="/admin">
        <span>Admin Panel</span>
        <span class="fas" style="margin-left: 10px;"></span>
      </a>
      <br />
    {{/if}}
    <a class="box" href="/torrent/upload">
      <span>Upload Torrent</span>
      <span class="fas" style="margin-left: 10px;"></span>
    </a>
    <br />
    <a class="box" href="/auth/change-password">
      <span>Change Password</span>
      <span class="fas" style="margin-left: 10px;"></span>
    </a>
  </main>
{{/inline}}

{{> layout }}