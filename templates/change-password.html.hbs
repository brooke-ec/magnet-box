{{#*inline "content"}}
  <main>
    <h1>Change Password</h1>
    <form method="POST">
      <div class="column">
        <label for="current">Current Password</label>
        <input type="password" id="current" name="current" minlength="6" required>
      </div>
      <div class="column">
        <label for="new">New Password</label>
        <input type="password" id="new" name="new" minlength="6" required>
      </div>
      <div class="column">
        <label for="confirm">Confirm Password</label>
        <input type="password" id="confirm" name="confirm" minlength="6" required>
      </div>
      {{#if error}}
        <div class="error">{{error}}</div>
      {{/if}}
      <button style="display: flex; align-items: center; gap: 10px" type="submit"><span class="fas"></span> Update Password</button>
    </form>
  </main>
{{/inline}}

{{> layout }}