{{#*inline "content"}}
<div class="scroll-container">
  <div class="torrent-list">
    <div class="torrent-list-header admin-list-header">
      <div>Username</div>
      <div>Role</div>
      <div>Actions</div>
    </div>
    {{#each users}}
      <div class="torrent-list-row">
        <div><span class="fas"></span>{{username}}</div>
        <div>
            <form action="{{role_uri}}" method="POST">
                <input type="checkbox" {{#if other}}disabled{{/if}} name="is_admin" onChange="this.form.submit()" checked={{is_admin}}>
            </form>
            {{#if is_admin}}
                admin
            {{else}}
                member
            {{/if}}
        </div>
        <div>
          <a {{#if other}}disabled{{/if}} href="{{reset_uri}}" class="fas"></a>
          <a {{#if other}}disabled{{/if}} href="{{delete_uri}}" class="fas"></a>
        </div>
      </div>
    {{/each}}
  </div>
</div>

<a class="box" href="/admin/user/create">
  <span>New User</span>
  <span class="fas icon-margin-left"></span>
</a>
{{/inline}}

{{> layout }}